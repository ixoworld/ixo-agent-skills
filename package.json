{
  "name": "ixo-skill-authoring",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test scripts/tests/*.test.ts",
    "validate": "node --import tsx scripts/capsules.ts validate",
    "build:capsules": "node --import tsx scripts/capsules.ts build",
    "publish:capsules": "node --import tsx scripts/capsules.ts publish"
  },
  "dependencies": {
    "blockstore-core": "6.1.2",
    "ipfs-unixfs-importer": "16.0.2",
    "yaml": "2.8.1",
    "zod": "4.1.9"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
