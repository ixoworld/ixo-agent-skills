{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ixo:governance:schema:resolution:0.2.0",
  "title": "IXO governance resolution v0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "id",
    "entityDid",
    "governingGroup",
    "decision",
    "authority",
    "flow",
    "effective",
    "conditions",
    "grants"
  ],
  "properties": {
    "kind": {
      "const": "ixo.governance.resolution"
    },
    "version": {
      "const": "0.2.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "entityDid": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s<>]+$"
    },
    "governingGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "chainId",
        "coreAddress",
        "proposalModuleAddress"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "chainId": {
          "type": "string",
          "pattern": "^[^\\s<>]+$"
        },
        "coreAddress": {
          "type": "string",
          "pattern": "^[^\\s<>]+$"
        },
        "proposalModuleAddress": {
          "type": "string",
          "pattern": "^[^\\s<>]+$"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "intendedOutcome"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "intendedOutcome": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authority": {
      "$ref": "urn:ixo:governance:schema:resolution:0.2.0#/$defs/authority"
    },
    "flow": {
      "$ref": "urn:ixo:governance:schema:resolution:0.2.0#/$defs/flow"
    },
    "effective": {
      "$ref": "urn:ixo:governance:schema:resolution:0.2.0#/$defs/effective"
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "urn:ixo:governance:schema:resolution:0.2.0#/$defs/condition"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "grants": {
      "type": "array",
      "items": {
        "$ref": "urn:ixo:governance:schema:resolution:0.2.0#/$defs/grant"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "$defs": {
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuerDid",
        "mandateCid",
        "activation",
        "maxDelegationSeconds",
        "maxInvocationSeconds",
        "revocation"
      ],
      "properties": {
        "issuerDid": {
          "type": "string",
          "pattern": "^did:[a-z0-9]+:[^\\s<>]+$"
        },
        "mandateCid": {
          "type": "string",
          "pattern": "^b[a-z2-7]{20,}$"
        },
        "activation": {
          "enum": [
            "passed",
            "executed"
          ]
        },
        "maxDelegationSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxInvocationSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "revocation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authorityDid",
            "resource",
            "maxStalenessSeconds"
          ],
          "properties": {
            "authorityDid": {
              "type": "string",
              "pattern": "^did:[a-z0-9]+:[^\\s<>]+$"
            },
            "resource": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9+.-]*:[^\\s*<>]+$"
            },
            "maxStalenessSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "planCid",
        "manifestCid",
        "gatewayDid"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "planCid": {
          "type": "string",
          "pattern": "^b[a-z2-7]{20,}$"
        },
        "manifestCid": {
          "type": "string",
          "pattern": "^b[a-z2-7]{20,}$"
        },
        "gatewayDid": {
          "type": "string",
          "pattern": "^did:[a-z0-9]+:[^\\s<>]+$"
        }
      }
    },
    "effective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notBefore",
        "expiresAt"
      ],
      "properties": {
        "notBefore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "evaluatorDid",
        "evidencePolicyCid",
        "maxAgeSeconds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "evaluatorDid": {
          "type": "string",
          "pattern": "^did:[a-z0-9]+:[^\\s<>]+$"
        },
        "evidencePolicyCid": {
          "type": "string",
          "pattern": "^b[a-z2-7]{20,}$"
        },
        "maxAgeSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "actorDid",
        "nodeId",
        "actionType",
        "can",
        "with",
        "inputsCid",
        "executorDid",
        "conditionIds",
        "maxExecutions",
        "delegation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "actorDid": {
          "type": "string",
          "pattern": "^did:[a-z0-9]+:[^\\s<>]+$"
        },
        "nodeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "actionType": {
          "type": "string",
          "minLength": 1
        },
        "can": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+/[a-zA-Z0-9_./-]+$",
          "not": {
            "const": "flow/block/execute"
          }
        },
        "with": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9+.-]*:[^\\s*<>]+$"
        },
        "inputsCid": {
          "type": "string",
          "pattern": "^b[a-z2-7]{20,}$"
        },
        "executorDid": {
          "type": "string",
          "pattern": "^did:[a-z0-9]+:[^\\s<>]+$"
        },
        "conditionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "maxExecutions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "delegation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowedAudiences",
            "maxDepth"
          ],
          "properties": {
            "allowedAudiences": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^did:[a-z0-9]+:[^\\s<>]+$"
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "maxDepth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "offchain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "tenant",
            "connectionId",
            "operations",
            "resourceIds"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "tenant": {
              "type": "string",
              "minLength": 1
            },
            "connectionId": {
              "type": "string",
              "minLength": 1
            },
            "operations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "resourceIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        }
      }
    },
    "cid": {
      "type": "string",
      "pattern": "^b[a-z2-7]{20,}$"
    }
  }
}
