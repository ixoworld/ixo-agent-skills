{
  "@context": {
    "@version": 1.1,
    "@protected": true,
    "ixoog": "https://w3id.org/ixo/outcome-graph/v1#",
    "ixoev": "https://w3id.org/ixo/evidence/v2#",
    "prov": "http://www.w3.org/ns/prov#",
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dct": "http://purl.org/dc/terms/",

    "TheoryOfChangeExtraction": "ixoog:TheoryOfChangeExtraction",
    "CausalGraphVersion": "ixoog:CausalGraphVersion",
    "CausalNode": "ixoog:CausalNode",
    "CausalEdge": "ixoog:CausalEdge",
    "EvidenceGraph": "ixoog:EvidenceGraph",
    "EvidenceArtifact": "ixoog:EvidenceArtifact",
    "ClaimEvidenceLink": "ixoog:ClaimEvidenceLink",
    "EvidenceGap": "ixoog:EvidenceGap",
    "ValidationFinding": "ixoog:ValidationFinding",
    "IssuanceRequest": "ixoog:IssuanceRequest",
    "OutcomeCertificate": "ixoog:OutcomeCertificate",
    "OracleEvaluationReceipt": "ixoog:OracleEvaluationReceipt",

    "causes": { "@id": "ixoog:causes", "@type": "@id" },
    "enables": { "@id": "ixoog:enables", "@type": "@id" },
    "moderates": { "@id": "ixoog:moderates", "@type": "@id" },
    "inhibits": { "@id": "ixoog:inhibits", "@type": "@id" },
    "prevents": { "@id": "ixoog:prevents", "@type": "@id" },
    "contributesTo": { "@id": "ixoog:contributesTo", "@type": "@id" },
    "supportsClaim": {
      "@id": "ixoog:supportsClaim",
      "@type": "@id",
      "@comment": "Claim-supports-claim: the subject claim's positive evaluation receipt (UDID) is admissible evidence for the object claim. The relation the wider IXO vocabulary does not yet define."
    },
    "refutesClaim": { "@id": "ixoog:refutesClaim", "@type": "@id" },

    "graphVersionRef": { "@id": "ixoog:graphVersionRef", "@type": "@id" },
    "tocExtractionRef": { "@id": "ixoog:tocExtractionRef", "@type": "@id" },
    "evidenceGraphRef": { "@id": "ixoog:evidenceGraphRef", "@type": "@id" },
    "supersedes": { "@id": "ixoog:supersedes", "@type": "@id" },
    "supersededBy": { "@id": "ixoog:supersededBy", "@type": "@id" },
    "wasDerivedFrom": { "@id": "prov:wasDerivedFrom", "@type": "@id" },
    "wasGeneratedBy": { "@id": "prov:wasGeneratedBy", "@type": "@id" },

    "nodeType": "ixoog:nodeType",
    "relationType": "ixoog:relationType",
    "polarity": "ixoog:polarity",
    "mechanism": "ixoog:mechanism",
    "comparator": "ixoog:comparator",
    "estimand": "ixoog:estimand",
    "validationStatus": "ixoog:validationStatus",
    "issuanceCritical": { "@id": "ixoog:issuanceCritical", "@type": "xsd:boolean" },
    "assessmentTier": { "@id": "ixoog:assessmentTier", "@type": "xsd:integer" },
    "tierLabel": "ixoog:tierLabel",
    "outcomeStatement": "ixoog:outcomeStatement",
    "unitOfAnalysis": "ixoog:unitOfAnalysis",
    "timeScope": "ixoog:timeScope",
    "confidenceBps": { "@id": "ixoev:confidenceBps", "@type": "ixoev:BasisPointScore" },
    "coverageBps": { "@id": "ixoog:coverageBps", "@type": "ixoev:BasisPointScore" },
    "receiptCid": "ixoog:receiptCid",
    "jti": "ixoog:jti",
    "rubricId": "ixoog:rubricId",
    "engineHost": "ixoog:engineHost",
    "verdictClass": "ixoog:verdictClass",
    "identificationDisclosures": { "@id": "ixoog:identificationDisclosures", "@container": "@list" },
    "revocationConditions": { "@id": "ixoog:revocationConditions", "@container": "@set" }
  }
}
