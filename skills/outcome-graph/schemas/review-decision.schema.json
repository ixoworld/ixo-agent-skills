{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/ixo/outcome-graph/schema/review-decision.v1.json",
  "title": "ReviewDecision",
  "description": "Host-signed human decision bound to one workflow revision, review packet, candidate digest, and state transition.",
  "type": "object",
  "properties": {
    "schema": { "const": "outcome.review-decision.v1" },
    "decision_id": { "$ref": "common.defs.v1.json#/$defs/content_addressed_uri" },
    "workflow_id": { "type": "string", "minLength": 1 },
    "manifest_revision": { "type": "integer", "minimum": 1 },
    "state_in": { "$ref": "common.defs.v1.json#/$defs/workflow_state" },
    "state_out": { "$ref": "common.defs.v1.json#/$defs/workflow_state" },
    "candidate_digest": { "$ref": "common.defs.v1.json#/$defs/sha256_hex" },
    "packet_ref": { "type": "string", "pattern": "^urn:ixo:review-packet:" },
    "reviewer_did": { "type": "string", "pattern": "^did:[a-z0-9]+:" },
    "decision": { "type": "string", "enum": ["approve", "reject"] },
    "decided_at": { "$ref": "common.defs.v1.json#/$defs/iso_datetime" },
    "proof": {
      "type": "object",
      "properties": {
        "type": { "const": "Ed25519HostSignatureV1" },
        "verification_method": { "type": "string", "minLength": 1 },
        "proof_value": { "type": "string", "minLength": 40 }
      },
      "required": ["type", "verification_method", "proof_value"],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "decision_id",
    "workflow_id",
    "manifest_revision",
    "state_in",
    "state_out",
    "candidate_digest",
    "packet_ref",
    "reviewer_did",
    "decision",
    "decided_at",
    "proof"
  ],
  "additionalProperties": false
}
