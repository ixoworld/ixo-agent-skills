    "triangle-diagonal": [[[[0, 0], [20000, 0], [10000, 20000], [0, 0]]]],
    "collinear-vertex": [[[[0, 0], [5000, 0], [10000, 0], [10000, 10000], [0, 10000], [0, 0]]]]
  },
